# Local, disposable databases only. Docker Compose works without this file.
DATABASE_URL=postgres://lab:lab_local@127.0.0.1:55432/lab
TEST_DATABASE_URL=postgres://lab:lab_local@127.0.0.1:55433/lab_test
PORT=3001
# Same public origin used in the browser. Use http://127.0.0.1:5173 for Playwright.
AUTH_BASE_URL=http://localhost:5173
# Optional fixed origins for staging or another public frontend.
AUTH_ADDITIONAL_ORIGINS=
# Local development only. Production requires a unique random secret of 32+ characters.
AUTH_SECRET=local-development-only-secret-at-least-32-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=GSO engineering lab <lab@localhost>
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are optional for local Mailpit.

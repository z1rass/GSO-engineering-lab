      "description": "A legible preparation state with subdued mint coloring.",
      "html": "<span class=\"ds-status\">In Vorbereitung</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;min-height:28px;padding:4px 10px;border:1px solid #3c514a;border-radius:7px;background:#27332f;color:#c0dcd1;font:600 11px/1.3 \"Space Grotesk\",Arial,sans-serif}"
    },
    {
      "name": "Collection Card",
      "kind": "card",
      "refersTo": "collection-card",
      "description": "One linked Idea or Project in a single-column collection, with a trailing square abstract cover.",
      "html": "<a class=\"ds-collection-card\" href=\"#idea\"><div class=\"ds-collection-content\"><small>IDEE</small><strong>Zusammen etwas bauen</strong><span>Eine Idee, aus der gemeinsame Arbeit entstehen kann.</span></div><img class=\"ds-collection-cover\" src=\"/covers/event-glass.jpg\" alt=\"\" width=\"148\" height=\"148\"></a>",
      "css": ".ds-collection-card{display:flex;align-items:center;gap:22px;min-height:164px;padding:20px 22px;border:1px solid #353535;border-radius:15px;background:var(--card,#202020);color:var(--ink,#f4f3f0);font-family:\"Space Grotesk\",Arial,sans-serif;text-decoration:none;transition:background 180ms,border-color 180ms}.ds-collection-content{display:grid;gap:9px;flex:1;min-width:0}.ds-collection-content small{color:var(--accent,#bdd8d2);font-size:11px;font-weight:700;letter-spacing:.08em}.ds-collection-content strong{font-size:27px;font-weight:500;line-height:1.2;letter-spacing:-.025em;overflow-wrap:anywhere}.ds-collection-content span{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:var(--muted,#aaa9a6);font-size:15px;line-height:1.6}.ds-collection-cover{flex:0 0 148px;width:148px;height:148px;object-fit:cover;border-radius:11px}.ds-collection-card:hover{border-color:#60605f;background:#262626}.ds-collection-card:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}@media(max-width:540px){.ds-collection-card{gap:14px;padding:16px}.ds-collection-cover{flex-basis:92px;width:92px;height:92px}.ds-collection-content strong{font-size:20px}}@media(prefers-reduced-motion:reduce){.ds-collection-card{transition:none}}"
    },
    {
      "name": "Event Timeline Card",
      "kind": "custom",
      "refersTo": "event-timeline-card",
      "description": "A date rail, linked Event content, and a persistent square abstract cover.",
      "html": "<div class=\"ds-timeline\"><div class=\"ds-timeline-date\"><strong>2. Dez.</strong><span>Dienstag</span></div><span class=\"ds-timeline-rail\" aria-hidden=\"true\"></span><a class=\"ds-timeline-card\" href=\"#event\"><span class=\"ds-timeline-content\"><span class=\"ds-timeline-time\">12:00</span><strong>Hello World</strong><span class=\"ds-timeline-place\">GSO</span><span class=\"ds-timeline-state\">In Vorbereitung</span></span><img class=\"ds-timeline-cover\" src=\"/covers/event-ribbon.jpg\" alt=\"\" width=\"160\" height=\"160\"></a></div>",
      "css": ".ds-timeline{display:grid;grid-template-columns:142px 24px minmax(0,1fr);gap:20px;color:var(--ink,#f4f3f0);font-family:\"Space Grotesk\",Arial,sans-serif}.ds-timeline-date{display:flex;flex-direction:column;gap:4px;padding-top:8px}.ds-timeline-date strong{font-size:23px;font-weight:600;letter-spacing:-.04em}.ds-timeline-date span{color:var(--muted,#aaa9a6);font-size:15px}.ds-timeline-rail{position:relative;width:1px;margin-inline:auto;background:#343434}.ds-timeline-rail:before{content:\"\";position:absolute;top:13px;left:-4px;width:9px;height:9px;border-radius:50%;background:#898986}.ds-timeline-card{display:grid;grid-template-columns:minmax(0,1fr) 160px;gap:20px;min-height:180px;padding:20px;border:1px solid #353535;border-radius:15px;background:var(--card,#202020);color:var(--ink,#f4f3f0);text-decoration:none;transition:background 180ms,border-color 180ms}.ds-timeline-content{display:flex;flex-direction:column;align-items:flex-start;min-width:0}.ds-timeline-card:hover{border-color:#60605f;background:#262626}.ds-timeline-card:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}.ds-timeline-time,.ds-timeline-place{color:var(--muted,#aaa9a6);font-size:14px}.ds-timeline-content strong{margin:12px 0 10px;font-size:30px;font-weight:500;letter-spacing:-.035em;overflow-wrap:anywhere}.ds-timeline-state{margin-top:auto;padding-top:16px;color:var(--accent,#bdd8d2);font-size:13px;font-weight:600}.ds-timeline-cover{display:block;width:160px;height:160px;object-fit:cover;border-radius:11px}@media(max-width:760px){.ds-timeline{grid-template-columns:90px 12px minmax(0,1fr);gap:12px}.ds-timeline-card{grid-template-columns:minmax(0,1fr) 102px;gap:14px}.ds-timeline-cover{width:102px;height:102px}}@media(max-width:540px){.ds-timeline{grid-template-columns:1fr;gap:8px}.ds-timeline-date{flex-direction:row;align-items:baseline;gap:9px;padding:0}.ds-timeline-rail{display:none}.ds-timeline-card{grid-template-columns:minmax(0,1fr) 84px;gap:10px;padding:16px}.ds-timeline-cover{width:84px;height:84px}}@media(prefers-reduced-motion:reduce){.ds-timeline-card{transition:none}}"
    },
    {
      "name": "Creation Cover",
      "kind": "custom",
      "refersTo": "creation-cover",
      "description": "A square abstract cover paired with the large title; title first and short image second on mobile for Ideas, Events, and Projects.",
      "html": "<div class=\"ds-creation-layout\"><label class=\"ds-creation-title\">Titel<input value=\"Dein Event\" aria-label=\"Titel\"></label><div class=\"ds-creation-cover\"><img src=\"/covers/event-ribbon.jpg\" alt=\"\" width=\"600\" height=\"600\"></div></div>",
      "css": ".ds-creation-layout{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.25fr);gap:20px 34px;align-items:start;background:#073332;color:#f4f3f0;font-family:\"Space Grotesk\",Arial,sans-serif}.ds-creation-title{grid-column:2;grid-row:1;display:grid;gap:8px;color:#b7cfca;font-size:12px}.ds-creation-title input{min-height:78px;padding:10px 0;border:0;border-bottom:1px solid #315e5b;border-radius:0;background:transparent;color:#f4f3f0;font:500 40px/1.1 \"Space Grotesk\",Arial,sans-serif;letter-spacing:-.045em}.ds-creation-title input:focus-visible{outline:2px solid #d5f1ea;outline-offset:3px}.ds-creation-cover{grid-column:1;grid-row:1;overflow:hidden;aspect-ratio:1;border-radius:18px;background:#164b49}.ds-creation-cover img{display:block;width:100%;height:100%;object-fit:cover}@media(max-width:760px){.ds-creation-layout{grid-template-columns:1fr}.ds-creation-title{grid-column:1;grid-row:1}.ds-creation-cover{grid-column:1;grid-row:2;width:100%;height:220px;aspect-ratio:auto}}@media(max-width:540px){.ds-creation-cover{height:180px}}"
    },
    {
      "name": "Date Picker",
      "kind": "input",
      "refersTo": "schedule-trigger",
      "description": "Localized date trigger and calendar popover with explicit month, selected day, today, and clear controls.",
      "html": "<div class=\"ds-schedule-field\"><span class=\"ds-schedule-label\">Datum</span><button class=\"ds-schedule-trigger\" type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 3v4M17 3v4M3 10h18\"/></svg>Datum wählen<span class=\"ds-schedule-chevron\">⌄</span></button><div class=\"ds-calendar\" role=\"dialog\" aria-label=\"Datum\"><div class=\"ds-calendar-head\"><strong>September 2026</strong><span>‹ &nbsp; ›</span></div><div class=\"ds-calendar-grid\"><small>MO</small><small>DI</small><small>MI</small><small>DO</small><small>FR</small><small>SA</small><small>SO</small><button type=\"button\">21</button><button type=\"button\">22</button><button type=\"button\">23</button><button type=\"button\">24</button><button type=\"button\">25</button><button type=\"button\" aria-pressed=\"true\">26</button><button type=\"button\">27</button></div><div class=\"ds-calendar-foot\"><button type=\"button\">Heute</button><button type=\"button\">Entfernen</button></div></div></div>",
      "css": ".ds-schedule-field{position:relative;display:grid;gap:7px;width:300px;color:var(--ink,#f4f3f0);font-family:\"Space Grotesk\",Arial,sans-serif}.ds-schedule-label{color:var(--muted,#aaa9a6);font-size:12px;font-weight:500}.ds-schedule-trigger{display:flex;align-items:center;gap:9px;min-height:50px;padding:10px 12px;border:1px solid var(--line,#383838);border-radius:9px;background:var(--card,#202020);color:var(--ink,#f4f3f0);font:500 14px/1.4 \"Space Grotesk\",Arial,sans-serif;text-align:left}.ds-schedule-trigger svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;color:var(--muted,#aaa9a6)}.ds-schedule-chevron{margin-left:auto;color:var(--muted,#aaa9a6)}.ds-schedule-trigger:hover,.ds-schedule-trigger[aria-expanded=\"true\"]{border-color:var(--accent,#bdd8d2);background:var(--card-hover,#292929)}.ds-schedule-trigger:focus-visible,.ds-calendar button:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}.ds-calendar{padding:16px;border:1px solid #555;border-radius:13px;background:#242424;color:#f4f3f0;box-shadow:0 16px 48px #0008}.ds-calendar-head,.ds-calendar-foot{display:flex;justify-content:space-between;align-items:center}.ds-calendar-head strong{font-size:15px}.ds-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:12px}.ds-calendar-grid small,.ds-calendar-grid button{display:grid;place-items:center;min-height:35px;font-size:12px}.ds-calendar-grid small{color:#a8a8a4}.ds-calendar-grid button{border:0;border-radius:7px;background:transparent;color:#ededeb}.ds-calendar-grid button:hover{background:#3c3c3c}.ds-calendar-grid button[aria-pressed=\"true\"]{background:#e9e9e5;color:#171717;font-weight:700}.ds-calendar-foot{margin-top:12px;padding-top:10px;border-top:1px solid #454545}.ds-calendar-foot button{border:0;background:transparent;color:#c7dcd5;font-size:12px;font-weight:600}"
    },
    {
      "name": "Time Picker",
      "kind": "input",
      "refersTo": "schedule-popover",
      "description": "Localized half-hour suggestions with an explicit custom-time input and clear action.",
      "html": "<div class=\"ds-time-field\"><span class=\"ds-time-label\">Beginn</span><button class=\"ds-time-trigger\" type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"true\">10:00<span>⌄</span></button><div class=\"ds-time-panel\" role=\"dialog\" aria-label=\"Beginn\"><div class=\"ds-time-head\"><strong>Beginn</strong><small>Europe/Berlin</small></div><div class=\"ds-time-options\"><button type=\"button\">09:00</button><button type=\"button\">09:30</button><button type=\"button\" aria-pressed=\"true\">10:00</button><button type=\"button\">10:30</button><button type=\"button\">11:00</button><button type=\"button\">11:30</button></div><div class=\"ds-time-custom\"><label>Andere Uhrzeit<input type=\"time\" value=\"10:00\"></label><button type=\"button\">Fertig</button></div><button class=\"ds-time-clear\" type=\"button\">Zeit entfernen</button></div></div>",
      "css": ".ds-time-field{display:grid;gap:7px;width:255px;color:var(--ink,#f4f3f0);font-family:\"Space Grotesk\",Arial,sans-serif}.ds-time-label{color:var(--muted,#aaa9a6);font-size:12px}.ds-time-trigger{display:flex;justify-content:space-between;align-items:center;min-height:50px;padding:10px 12px;border:1px solid var(--line,#383838);border-radius:9px;background:var(--card,#202020);color:var(--ink,#f4f3f0);font:500 14px/1.4 \"Space Grotesk\",Arial,sans-serif}.ds-time-trigger:hover,.ds-time-trigger[aria-expanded=\"true\"]{border-color:var(--accent,#bdd8d2);background:var(--card-hover,#292929)}.ds-time-panel{padding:16px;border:1px solid #555;border-radius:13px;background:#242424;color:#f4f3f0;box-shadow:0 16px 48px #0008}.ds-time-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:12px}.ds-time-head strong{font-size:14px}.ds-time-head small{color:#a5a5a2;font-size:11px}.ds-time-options{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.ds-time-options button{min-height:36px;border:0;border-radius:6px;background:#333;color:#e7e7e5;font-size:12px}.ds-time-options button:hover{background:#494949}.ds-time-options button[aria-pressed=\"true\"]{background:#e9e9e5;color:#171717;font-weight:700}.ds-time-custom{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:end;margin-top:11px;padding-top:11px;border-top:1px solid #454545}.ds-time-custom label{display:grid;gap:5px;color:#bbb;font-size:11px}.ds-time-custom input{width:100%;min-height:36px;padding:5px 7px;border:1px solid #565656;border-radius:7px;background:#333;color:white}.ds-time-custom>button{min-height:36px;padding:0 9px;border:0;border-radius:7px;background:#e9e9e5;color:#161616;font-size:12px;font-weight:700}.ds-time-clear{margin-top:6px;border:0;background:transparent;color:#c7dcd5;font-size:12px;font-weight:600}.ds-time-trigger:focus-visible,.ds-time-panel button:focus-visible,.ds-time-custom input:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}"
    },
    {
      "name": "Semantic Icons",
      "kind": "custom",
      "refersTo": "icon",
      "description": "A consistent inline SVG set, always beside visible text on actions and routes.",
      "html": "<div class=\"ds-icon-row\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16v4a3 3 0 0 0 0 6v4H4v-4a3 3 0 0 0 0-6V5Z\"/></svg>Events</span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"15\" rx=\"2\"/><path d=\"M3 10h18M9 5V3h6v2\"/></svg>Projekte</span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 18h6M10 21h4M8.5 15.5C7 14.4 6 12.8 6 10.5a6 6 0 1 1 12 0c0 2.3-1 3.9-2.5 5l-.5 2.5h-6l-.5-2.5Z\"/></svg>Ideen</span></div>",
      "css": ".ds-icon-row{display:flex;flex-wrap:wrap;gap:14px;padding:16px;background:var(--paper,#151515);color:var(--ink,#f4f3f0);font:500 13px/1.4 \"Space Grotesk\",Arial,sans-serif}.ds-icon-row span{display:inline-flex;align-items:center;gap:8px}.ds-icon-row svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;color:var(--accent,#bdd8d2)}"
    }
  ],
  "narrative": {
    "northStar": "The Open Workshop",
    "overview": "**Creative North Star: \"The Open Workshop\"**\n\nThe Lab feels like a place where people can arrive, understand what is happening, and take a concrete next step. Near-black working surfaces, pale text, and a restrained mint signal give technical character without making the community look like an official school service. The GSO name remains a quiet context cue; the visual emphasis belongs to the work and the people who start it.\n\nThe public entrance has room to breathe and a clear path into Events, Projects, and Ideas. Home, Seasons, profile, Ops, and operational routes share the same charcoal panels, borders, icons, and interaction states at a denser rhythm. Luma's legible event cadence informs the date rail and generous cards, while the Lab keeps its own compact mark and Discover → Join → Own story. Six original abstract covers give Ideas, Events, and Projects visual identity without implying a real speaker, attendee, room, or confirmed schedule.",
    "keyCharacteristics": [
      "A charcoal canvas and subtly lighter, stroked surfaces instead of floating shadows; creation pages shift into a cover-matched deep palette.",
      "Large, calm Space Grotesk headings with compact labels and generous line spacing for explanation.",
      "Off-white primary actions; mint marks state, focus, and technical details on default pages, with cover-matched accents in creation.",
      "One-column collections with square abstract covers, an event date rail, and focused two-column creation flows on wide screens.",
      "One coherent SVG icon set and localized date/time controls across navigation, actions, detail facts, and forms."
    ],
    "rules": [
      {
        "name": "The Mint Signal Rule",
        "body": "Use mint for orientation, state, and focus on default pages; use the selected cover's pale accent in creation, while off-white carries the primary action.",
        "section": "colors"
      },
      {
        "name": "The Cover Tone Rule",
        "body": "Apply a cover's palette only to Idea, Event, and Project creation; change the surrounding chrome and form surfaces as one coordinated set.",
        "section": "colors"
      },
      {
        "name": "The Clear First Read Rule",
        "body": "A large heading names the purpose; the next line explains it before a person must decide what to click.",
        "section": "typography"
      },
      {
        "name": "The One Path Rule",
        "body": "Give each collection one dominant reading direction and each form one obvious next action.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "A surface earns separation through tone and a hairline before any shadow is considered.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the charcoal tonal ladder and thin borders to structure content.",
      "**Do** reserve mint for state, focus, technical detail, and small accents.",
      "**Do** keep collections in a single reading column and Events in an honest date timeline.",
      "**Do** use the stable, title-derived abstract cover consistently across an Activity's views.",
      "**Do** pair semantic SVG icons with readable labels and keep picker dates and times localized.",
      "**Do** preserve visible focus, readable contrast, reduced-motion behavior, and usable German and English layouts."
    ],
    "donts": [
      "**Don't** imply official school endorsement with a dominant GSO crest or institutional palette.",
      "**Don't** fill pages with invented attendee photos, speakers, confirmed rooms, or schedules.",
      "**Don't** use a cover palette as a global category color outside Idea, Event, and Project creation.",
      "**Don't** make a date or time icon the only cue to operate a picker.",
      "**Don't** make “Interested” look like registration or Project membership.",
      "**Don't** replace the white primary action with mint everywhere or build a bright multicolor card wall."
    ]
  }
}

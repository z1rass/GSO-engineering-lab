      "css": ".ds-event-fact{--fg:#1f2742;--muted:#596381;--line:#bdc5de;display:flex;align-items:center;gap:14px;color:var(--fg);font-family:\"Space Grotesk\",sans-serif}.ds-date-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:58px;height:58px;border:1px solid var(--line);border-radius:11px;background:#1f274212}.ds-date-tile small{font-size:10px;font-weight:700}.ds-date-tile strong{font-size:25px;line-height:1}.ds-event-fact>span:last-child{display:grid;gap:5px}.ds-event-fact>span:last-child strong{font-size:18px}.ds-event-fact>span:last-child small{color:var(--muted);font-size:14px}"

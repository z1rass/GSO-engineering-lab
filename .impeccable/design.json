  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The strongest action, rendered in warm white with dark text.",
      "html": "<button class=\"ds-button-primary\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Idee teilen</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid var(--action,#f0efeb);border-radius:10px;background:var(--action,#f0efeb);color:#191919;font:700 14px/1.4 \"Space Grotesk\",Arial,sans-serif;cursor:pointer;transition:background 180ms,border-color 180ms}.ds-button-primary svg{flex:none}.ds-button-primary:hover,.ds-button-primary:active{border-color:var(--action-hover,#d0e4df);background:var(--action-hover,#d0e4df);color:#171b1a}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Standard Field",
      "kind": "input",
      "refersTo": "field",
      "description": "A labeled, neutral field with a mint focus state.",
      "html": "<label class=\"ds-field\">Titel<input type=\"text\" placeholder=\"Titel eingeben\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:#d2d2d0;font:500 15px/1.45 \"Space Grotesk\",Arial,sans-serif}.ds-field input{min-height:52px;padding:11px 14px;border:1px solid #4b4b4b;border-radius:10px;background:#303030;color:var(--ink,#f4f3f0);font:400 16px/1.4 \"Space Grotesk\",Arial,sans-serif;caret-color:var(--accent,#bdd8d2)}.ds-field input::placeholder{color:#858583}.ds-field input:hover{border-color:#707070}.ds-field input:focus-visible{border-color:var(--accent,#bdd8d2);outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "One-row desktop routes with semantic inline SVG icons and a charcoal current-page tile.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Hauptnavigation\"><a href=\"#home\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10Z\"/><path d=\"M9 21v-7h6v7\"/></svg>Home</a><a href=\"#events\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16v4a3 3 0 0 0 0 6v4H4v-4a3 3 0 0 0 0-6V5Z\"/></svg>Events</a><a href=\"#projects\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"15\" rx=\"2\"/><path d=\"M3 10h18M9 5V3h6v2\"/></svg>Projekte</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:2px;padding:8px;background:var(--paper,#151515);font-family:\"Space Grotesk\",Arial,sans-serif}.ds-nav a{display:inline-flex;align-items:center;gap:8px;min-height:42px;padding:8px 11px;border-radius:9px;color:#a8a8a5;font-size:13px;font-weight:500;text-decoration:none;white-space:nowrap;transition:background 180ms,color 180ms}.ds-nav svg{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;color:#878786}.ds-nav a:hover{background:var(--surface,#252525);color:var(--ink,#f4f3f0)}.ds-nav a:hover svg,.ds-nav a[aria-current=\"page\"] svg{color:var(--accent,#bdd8d2)}.ds-nav a[aria-current=\"page\"]{background:#2a2a2a;color:var(--ink,#f4f3f0);font-weight:600}.ds-nav a:focus-visible{outline:2px solid var(--accent,#bdd8d2);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Status Label",
      "kind": "chip",

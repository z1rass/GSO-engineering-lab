      "html": "<a class=\"ds-idea-card\" href=\"#idea\"><img src=\"/covers/event-glass.jpg\" alt=\"\"><span class=\"ds-idea-copy\"><small>22.09.2026</small><strong>Ein offenes Hardware-Lab</strong><span>Ein Ort, an dem wir Elektronik gemeinsam ausprobieren.</span></span></a>",
      "css": ".ds-idea-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid #373737;border-radius:15px;background:#202020;color:#f7f7f5;text-decoration:none;font-family:\"Space Grotesk\",sans-serif;transition:transform .2s,border-color .2s}.ds-idea-card:hover{transform:translateY(-2px);border-color:#636363}.ds-idea-card:focus-visible{outline:2px solid #b7d9d3;outline-offset:3px}.ds-idea-card img{width:100%;aspect-ratio:1.18;object-fit:cover}.ds-idea-copy{display:grid;gap:12px;padding:23px}.ds-idea-copy small,.ds-idea-copy span{color:#aaa;font-size:12px}.ds-idea-copy strong{font-size:23px;line-height:1.17}.ds-idea-copy span{font-size:14px;line-height:1.55}@media(prefers-reduced-motion:reduce){.ds-idea-card{transition:none}}"

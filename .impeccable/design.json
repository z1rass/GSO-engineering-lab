    {
      "name": "Event Timeline Card",
      "kind": "card",
      "refersTo": "event-card",
      "description": "One Event row with a date rail, compact facts, and trailing cover.",
      "html": "<div class=\"ds-event-row\"><div class=\"ds-date\"><strong>15. Okt.</strong><span>2026 Donnerstag</span></div><span class=\"ds-rail\"></span><a class=\"ds-event-card\" href=\"#event\"><span class=\"ds-event-copy\"><small>18:00</small><strong>Build Night: kleine Tools, große Ideen</strong><span>GSO · Raum angefragt</span></span><img src=\"/covers/project-paper.jpg\" alt=\"\"></a></div>",
      "css": ".ds-event-row{display:grid;grid-template-columns:145px 27px minmax(0,1fr);gap:14px;color:#f7f7f5;font-family:\"Space Grotesk\",sans-serif}.ds-date{display:grid;align-content:start;gap:4px;padding-top:20px;font-variant-numeric:tabular-nums}.ds-date strong{font-size:22px}.ds-date span,.ds-event-copy small,.ds-event-copy span{color:#aaa9aa;font-size:14px}.ds-rail{justify-self:center;width:2px;background:repeating-linear-gradient(to bottom,#343434 0 7px,transparent 7px 14px)}.ds-event-card{display:grid;grid-template-columns:minmax(0,1fr) 136px;gap:24px;min-height:168px;padding:21px 23px;border:1px solid #373737;border-radius:15px;background:#202020;color:inherit;text-decoration:none;transition:transform .2s,background .2s,border-color .2s}.ds-event-card:hover{transform:translateY(-2px);background:#262626;border-color:#636363}.ds-event-card:focus-visible{outline:2px solid #b7d9d3;outline-offset:3px}.ds-event-copy{display:flex;flex-direction:column;gap:9px}.ds-event-copy strong{font-size:26px;line-height:1.17}.ds-event-copy span{margin-top:auto}.ds-event-card img{width:136px;aspect-ratio:1;object-fit:cover;border-radius:10px}@media(max-width:690px){.ds-event-row{grid-template-columns:1fr}.ds-date,.ds-rail{display:none}}@media(prefers-reduced-motion:reduce){.ds-event-card{transition:none}}"
    },
    {
      "name": "Idea Card",
